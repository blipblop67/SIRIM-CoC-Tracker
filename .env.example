# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional bot token from @BotFather for automated Telegram notifications.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Optional Telegram user or supergroup/channel chat ID to receive morning scan digests.
# Can be a single Chat ID (e.g. "-1001234567890") or include the topic ID directly (e.g. "-1001234567890:42" or "-1001234567890/42")
TELEGRAM_CHAT_ID=""

# TELEGRAM_TOPIC_ID: Optional forum supergroup thread/topic ID (e.g. "42")
TELEGRAM_TOPIC_ID=""

# ALLOWED_EMAIL_DOMAINS: Who may sign in to the tracker (comma-separated). Default: cytron.io
ALLOWED_EMAIL_DOMAINS="cytron.io"

# ALLOWED_EMAILS: Optional extra individual addresses outside those domains (comma-separated).
ALLOWED_EMAILS=""

# GOOGLE_OAUTH_CLIENT_SECRET: Lets the agent stay connected to one Google account so the daily
# 08:30 scan can read Gmail and update the Sheet without anyone signed in.
# Google Cloud Console -> APIs & Services -> Credentials -> the "Web client (auto created by Google Service)"
# OAuth client of this Firebase project -> copy its Client secret. Also add
#   <APP_URL>/api/automation/google/callback
# under "Authorized redirect URIs" on that same client.
GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional: only if you use a different OAuth client than the Firebase one
GOOGLE_OAUTH_CLIENT_ID=""

# SIRIM_AGENT_EMAILS: Optional. SIRIM agent / consultant addresses or domains whose emails always count as
# SIRIM emails (comma-separated). Can also be set in the app under Automation settings.
SIRIM_AGENT_EMAILS=""
